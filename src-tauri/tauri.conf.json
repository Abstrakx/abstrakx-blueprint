{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "abstrakx-blueprint",
  "version": "0.3.0",
  "identifier": "com.abstrakx-enterprise.blueprint",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Abstrakx Blueprint",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["abstrakx-blueprint"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/Abstrakx/abstrakx-blueprint/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGNTBEMUEwNEFBQTQyMzgKUldRNFFxcEtvTkZRajkyOHdYYzZKK3lxbWc5Yi9tY1BndDNINWZNditrakFrYkZSdFFSbmpTcFkK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
